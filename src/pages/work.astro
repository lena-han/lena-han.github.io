---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Work — Lena Han" page="work" bodyBg="#d7a4fa57">
  <div class="work-page">
    <div class="section">
      <h2 class="section-label">now</h2>
      <ul class="item-list">
        <li>
          <span class="item-title">Product Manager</span>
          <span class="item-meta">— The Philadelphia Inquirer</span>
        </li>
        <li class="bullet">Building AI and workflow tools to help local and hyperlocal newsletters scale sustainably</li>
        <li class="bullet">Personalizing reading experiences in readers' inboxes and the app</li>
        <li class="bullet">Led technical migrations to Sailthru (email) and Braze (push)</li>
        <li class="bullet">Thinking through trust and community-building features with audiences</li>
      </ul>
    </div>

    <div class="section">
      <h2 class="section-label">focus areas</h2>
      <p class="focus-areas">newsletters · audience analytics · mobile · audience community-building · AI in the newsroom</p>
    </div>

    <div class="section">
      <h2 class="section-label">previously</h2>
      <ul class="item-list">
        <li>
          <span class="item-title">Editorial Data Analyst</span>
          <span class="item-meta">— Hearst Magazines · 2023–2024</span>
        </li>
        <li>
          <span class="item-title">Data Journalist</span>
          <span class="item-meta">— USAFacts · 2022–2023</span>
        </li>
      </ul>
    </div>

    <div class="section">
      <h2 class="section-label">recognition</h2>
      <ul class="item-list">
        <li>
          <span class="item-title"><a href="https://www.journalists.org/news/introducing-the-2025-cohort-of-the-womens-leadership-accelerator" target="_blank" rel="noopener">ONA Women's Leadership Accelerator</a></span>
          <span class="item-meta">· 2025 cohort</span>
        </li>
      </ul>
    </div>

    <p class="linkedin">You can also find me on <a href="https://www.linkedin.com/in/lena-han/" target="_blank" rel="noopener">LinkedIn</a>.</p>
  </div>
</Layout>

<style>
  .work-page {
    padding: 3rem;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.4rem;
    max-width: 900px;
  }

  .section {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  .section-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text);
    min-width: 160px;
    padding-top: 0.1rem;
    flex-shrink: 0;
  }

  .item-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .item-list li {
    font-size: 0.75rem;
    color: var(--text);
    line-height: 1.35;
  }

  .item-list li.bullet::before {
    content: '✦';
    margin-right: 0.4rem;
    font-size: 0.6rem;
    vertical-align: middle;
    opacity: 0.6;
  }

  .item-title {
    display: inline;
    font-weight: 500;
    color: var(--text);
    font-size: 0.77rem;
  }

  .item-title a {
    color: var(--text);
    border-bottom: 1px solid rgba(0,0,0,0.2);
    padding-bottom: 1px;
  }

  .item-title a:hover {
    text-decoration: none;
    border-bottom-color: transparent;
    background: #fef08a;
    border-radius: 2px;
    padding: 1px 3px;
    margin: 0 -3px;
  }

  .item-meta {
    color: var(--text);
    font-size: 0.75rem;
  }

  .item-desc {
    margin-top: 0.25rem;
    font-size: 0.72rem;
    color: var(--text-muted);
    max-width: 600px;
  }

  .focus-areas {
    font-size: 0.75rem;
    color: var(--text);
    line-height: 1.5;
  }

  .linkedin {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .linkedin a {
    color: var(--text-muted);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    text-decoration-color: rgba(0,0,0,0.3);
  }

  .linkedin a:hover {
    background: #fef08a;
    border-radius: 2px;
    padding: 1px 3px;
    margin: 0 -3px;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .work-page {
      padding: 2rem 1.5rem;
      min-height: auto;
      justify-content: flex-start;
      padding-top: 1.25rem;
    }

    .section {
      flex-direction: column;
      gap: 0.5rem;
    }

    .section-label {
      min-width: unset;
    }
  }
</style>
