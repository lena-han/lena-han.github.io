---
import Layout from '../layouts/Layout.astro';
---


<Layout title="Lena Han" page="home">
  <div class="home">
    <div class="home-inner">
      <div class="intro">
        <h1>Lena Han</h1>
        <p class="tagline">Working at the intersection of journalism and technology</p>
        <p class="bio">
          I build tools &amp; products that help journalists reach audiences. Always thinking about building products that serve the public interest, promote good storytelling, and teach us how to be better members of our community.
        </p>
        <p class="email">Email me at lena.angela.han [at] gmail.com</p>
        <div class="links">
          <a href="/work">what I'm working on →</a>
          <a href="/also">other things →</a>
        </div>
      </div>
      <img src="/headshot.png" alt="Lena Han" class="profile-img" />
    </div>

  </div>
</Layout>

<style>
  .home {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    padding: 0 3rem;
  }

  .home-inner {
    display: flex;
    align-items: center;
    gap: 4rem;
    max-width: 860px;
  }

  .intro {
    flex: 1;
    margin-bottom: 2.5rem;
  }

  .profile-img {
    width: 220px;
    height: 220px;
    object-fit: cover;
    border-radius: 12px;
    flex-shrink: 0;
  }

  /* ── Tablet ── */
  @media (max-width: 900px) {
    .home-inner {
      gap: 2.5rem;
    }

    .profile-img {
      width: 180px;
      height: 180px;
    }
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .home {
      padding: 2rem 1.5rem;
      height: auto;
      min-height: calc(100vh - 60px);
      justify-content: flex-start;
      padding-top: 1.25rem;
    }

    .home-inner {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 1.5rem;
    }

    .profile-img {
      width: 100%;
      height: 240px;
      border-radius: 10px;
    }

    .intro {
      margin-bottom: 0;
    }

    h1 {
      font-size: 1.4rem;
    }

    .bio {
      max-width: 100%;
    }
  }

  h1 {
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    letter-spacing: -0.01em;
  }

  .tagline {
    font-size: 1rem;
    color: var(--text);
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .bio {
    font-size: 0.92rem;
    color: var(--text);
    max-width: 460px;
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }

  .email {
    font-size: 0.88rem;
    color: var(--text);
    margin-bottom: 1.5rem;
  }

  .links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .links a {
    font-size: 0.85rem;
    color: var(--text);
    border-bottom: 1px solid rgba(0,0,0,0.2);
    padding-bottom: 1px;
  }

  .links a:hover {
    text-decoration: none;
    border-bottom-color: transparent;
    background: #fef08a;
    border-radius: 2px;
    padding: 1px 3px;
    margin: 0 -3px;
  }
</style>
